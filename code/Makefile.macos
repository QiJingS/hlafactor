UNAME_M := $(shell uname -m)
PLATFORM := Darwin-$(UNAME_M)

PREFIX = $(CURDIR)/_install/$(PLATFORM)
BUILD_DIR = $(CURDIR)/build/$(PLATFORM)
DIST_DIR = $(CURDIR)/dist
PKG_DIR = $(DIST_DIR)/$(APP)-$(VERSION)-$(PLATFORM)

RPATH := -Wl,-rpath,@executable_path/../lib -Wl,-rpath,$(PREFIX)/lib
HTS_LIB := $(PREFIX)/lib/libhts.dylib
PACKAGE_TAR := $(PKG_DIR).tar.gz

include Makefile.common

package: all
	rm -rf $(PKG_DIR)
	mkdir -p $(PKG_DIR)/bin
	mkdir -p $(PKG_DIR)/lib
	cp $(BUILD_DIR)/$(APP) $(PKG_DIR)/bin/
	cp README.md $(PKG_DIR)/
	cp -a $(PREFIX)/lib/libhts.dylib* $(PKG_DIR)/lib/ 2>/dev/null || true
	tar -czf $(PACKAGE_TAR) -C $(DIST_DIR) -- $(notdir $(PKG_DIR))