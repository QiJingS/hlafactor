includedir=/Users/qijingshen/Desktop/APPWAS/APPWAS/hlafactor/hlafactor/code/_install/Darwin-arm64/include
libdir=/Users/qijingshen/Desktop/APPWAS/APPWAS/hlafactor/hlafactor/code/_install/Darwin-arm64/lib

# Flags and libraries needed when linking against a static libhts.a
# (used by manual and semi-manual pkg-config(1)-style enquiries).
static_ldflags=
static_libs=-lpthread -lz -lm -lbz2 -llzma -lcurl 

Name: htslib
Description: C library for high-throughput sequencing data formats
Version: 1.23.1
Cflags: -I${includedir}
Libs: -L${libdir} -lhts
Libs.private: -L${libdir}  -lbz2 -lm -lpthread
Requires.private: zlib  liblzma
