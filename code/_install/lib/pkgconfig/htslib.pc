includedir=/well/ansari/users/dqc635/my_software/hlafactor/code/htslib/../_install/include
libdir=/well/ansari/users/dqc635/my_software/hlafactor/code/htslib/../_install/lib

# Flags and libraries needed when linking against a static libhts.a
# (used by manual and semi-manual pkg-config(1)-style enquiries).
static_ldflags=
static_libs=-lpthread -lz -lm -llzma

Name: htslib
Description: C library for high-throughput sequencing data formats
Version: 1.23.1
Cflags: -I${includedir}
Libs: -L${libdir} -lhts
Libs.private: -L${libdir}  -lm -lpthread
Requires.private: zlib  liblzma
